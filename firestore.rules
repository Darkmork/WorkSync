rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isString(field) {
      return field is string && field.size() > 0 && field.size() < 500;
    }

    function isList(field) {
      return field is list && field.size() < 500;
    }

    // True when the signed-in user is a member of the given group. Costs one
    // document read; only safe for single-document writes (not list queries).
    function isGroupMember(groupId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/groups/$(groupId))
        && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds;
    }

    // RSVP edits may only touch the caller's own entry. True when the write does
    // not change the `rsvps` map, or changes only the key equal to the caller's
    // uid — so a member can answer for themselves but never for anyone else.
    function rsvpEditIsOwnOnly() {
      return !('rsvps' in request.resource.data)
        || request.resource.data.rsvps == resource.data.get('rsvps', {})
        || request.resource.data.rsvps
            .diff(resource.data.get('rsvps', {}))
            .affectedKeys()
            .hasOnly([request.auth.uid]);
    }

    // A poll vote edit may only toggle the caller's own `votes.<uid>` entry, and
    // must not touch the immutable fields (status, candidates). This is what lets
    // a member change their own vote while leaving everyone else's intact.
    function voteEditIsOwnOnly() {
      return request.resource.data.status == resource.data.status
        && request.resource.data.candidates == resource.data.candidates
        && (
          !('votes' in request.resource.data)
          || request.resource.data.votes == resource.data.get('votes', {})
          || request.resource.data.votes
              .diff(resource.data.get('votes', {}))
              .affectedKeys()
              .hasOnly([request.auth.uid])
        );
    }

    // The poll's creator closing it: flips status to 'closed' (and may record a
    // winner). Only the creator may close a poll.
    function pollOwnerClosing() {
      return resource.data.createdBy == request.auth.uid
        && request.resource.data.status == 'closed';
    }

    match /users/{userId} {
      // Profiles (name + avatar) are readable by any signed-in user so that group
      // members can see each other. Email is included; restricting it would require
      // splitting sensitive fields into a private subdocument (follow-up).
      allow read: if isSignedIn();
      allow create, update: if isOwner(userId)
        && isString(request.resource.data.name)
        && isString(request.resource.data.email);
    }

    match /schedules/{userId} {
      // Readable by any signed-in user because recommendations need co-members'
      // availability. A "co-members only" rule is not expressible for list queries
      // without denormalizing the reader list onto each schedule (follow-up).
      allow read: if isSignedIn();
      allow create, update: if isOwner(userId)
        && isList(request.resource.data.blocks);
    }

    match /groups/{groupId} {
      // Only the owner, a member, or an invited email may read a group. Clients
      // must query by membership (array-contains uid / invited email); an
      // unconstrained list query is rejected because rules are not filters.
      allow read: if isSignedIn() && (
        request.auth.uid in resource.data.memberIds
        || request.auth.token.email in resource.data.get('invitedEmails', [])
      );
      allow create: if isOwner(request.resource.data.ownerId)
        && isString(request.resource.data.name)
        && isList(request.resource.data.memberIds);
      allow update: if isSignedIn() && (
        (request.auth.uid == resource.data.ownerId
          && isString(request.resource.data.name)
          && isList(request.resource.data.memberIds))
        ||
        (request.auth.token.email in resource.data.get('invitedEmails', [])
          && request.resource.data.ownerId == resource.data.ownerId
          && request.resource.data.name == resource.data.name
          && request.auth.uid in request.resource.data.memberIds
          && request.resource.data.memberIds.hasAll(resource.data.memberIds))
      );
      allow delete: if isSignedIn() && request.auth.uid == resource.data.ownerId;
    }

    match /tasks/{taskId} {
      allow read, delete: if isSignedIn() && request.auth.uid == resource.data.userId;
      allow create: if isSignedIn()
        && request.auth.uid == request.resource.data.userId
        && isString(request.resource.data.title);
      allow update: if isSignedIn() && request.auth.uid == resource.data.userId;
    }

    // Sessions belong to a group rather than a single owner. Only members of the
    // session's group may create or confirm it. Read stays open to any signed-in
    // user: a list query can't verify membership per document within Firestore's
    // get() limits, so the client filters sessions to the user's groups. A tighter
    // read rule needs group membership denormalized onto each session (follow-up).
    match /sessions/{sessionId} {
      allow read: if isSignedIn();
      allow create: if isString(request.resource.data.groupId)
        && isString(request.resource.data.title)
        && isString(request.resource.data.status)
        && isGroupMember(request.resource.data.groupId);
      allow update: if isString(request.resource.data.status)
        && isGroupMember(resource.data.groupId)
        && rsvpEditIsOwnOnly();
    }

    // Polls let a group vote among candidate meeting slots (approval voting).
    // Read stays open to any signed-in user (the client filters polls to the
    // user's groups, since a list query can't verify membership per document —
    // same limitation as sessions). Writes require group membership: a member
    // may toggle only their own vote, and only the creator may close the poll.
    match /polls/{pollId} {
      allow read: if isSignedIn();
      allow create: if isString(request.resource.data.groupId)
        && isString(request.resource.data.title)
        && request.resource.data.createdBy == request.auth.uid
        && isList(request.resource.data.candidates)
        && isGroupMember(request.resource.data.groupId);
      allow update: if isGroupMember(resource.data.groupId)
        && (voteEditIsOwnOnly() || pollOwnerClosing());
      allow delete: if isSignedIn() && request.auth.uid == resource.data.createdBy;
    }

    // Per-user notification inbox. Only Cloud Functions (Admin SDK, which bypasses
    // these rules) ever create or delete items; the owner may read their inbox and
    // mark items read. Clients are never allowed to write notifications to anyone.
    match /notifications/{userId}/items/{itemId} {
      allow read: if isOwner(userId);
      allow update: if isOwner(userId);
      allow create, delete: if false;
    }
  }
}
